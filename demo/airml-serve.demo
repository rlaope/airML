# demo/airml-serve.demo
# Recorded with vhs (https://github.com/charmbracelet/vhs)
# Run: vhs demo/airml-serve.demo

Output demo/airml-serve.gif

Set FontSize 18
Set Width 1200
Set Height 700
Set Theme "Dracula"
Set TypingSpeed 50ms

Type "airml serve --bind 127.0.0.1:8080 &" Enter
Sleep 2s
Type "clear" Enter

Type 'curl -s http://127.0.0.1:8080/v1/embeddings \' Enter
Type '  -H "Content-Type: application/json" \' Enter
Type '  -d "{\"model\":\"bge-small-en\",\"input\":[\"Hello\"]}" \' Enter
Type '  | jq ".data[0].embedding[:5]"' Enter
Sleep 3s
